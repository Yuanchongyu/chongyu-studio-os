# Public/browser-safe values (future authenticated frontend use)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Server-only values for Vercel Functions. Never commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_SERVER_SIDE_ONLY
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=SERVER_SIDE_ONLY
ANTHROPIC_API_KEY=SERVER_SIDE_ONLY
STUDIO_ACCESS_TOKEN=CREATE_A_LONG_RANDOM_PRIVATE_TOKEN

# Optional model overrides
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_MODEL=claude-sonnet-5

STUDIO_MCP_BASE_URL=https://mcp.your-domain.com
